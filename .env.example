# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to .env.local and paste your real values.
# Both are safe to expose to the browser (the anon key is protected by RLS).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role (SECRET) key — server-only, bypasses RLS. Required for the Razorpay
# webhook to confirm registrations after payment. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-placeholder
