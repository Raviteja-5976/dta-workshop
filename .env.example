# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to .env.local and paste your real values.
# Both are safe to expose to the browser (the anon key is protected by RLS).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role (SECRET) key — server-only, bypasses RLS. Required for the Razorpay
# webhook to confirm registrations after payment. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-placeholder

# Name of the Supabase Storage bucket that holds workshop thumbnail / cover
# images. Safe to expose to the browser. When a workshop's cover_image is stored
# as a bare path/filename (e.g. "portfolio.png") it is served from this public
# bucket. Leave blank to keep using full image URLs as-is.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=workshop-thumbnails

# --- Email (Resend) ---------------------------------------------------------
# Resend API key (server-only secret). Get it from https://resend.com/api-keys.
RESEND_API_KEY=re_your_resend_api_key
# The verified "from" address emails are sent as. The domain must be verified in
# Resend (Domains). Format: "Name <address@domain>".
EMAIL_FROM=DevTrackAcademy <info@devtrackacademy.com>
# Public site URL used to build links inside emails (Explore Workshops, Dashboard).
NEXT_PUBLIC_SITE_URL=https://workshop.devtrackacademy.com

# --- Analytics (Google Analytics 4 / gtag.js) -------------------------------
# GA4 Measurement ID. When set, gtag.js loads site-wide and GA4 enhanced
# measurement tracks page views + clicks. Leave unset to disable (e.g. in dev).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
